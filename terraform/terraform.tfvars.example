# Copier ce fichier en terraform.tfvars et mettre vos valeurs.

# ID du projet donné par le lab.
project_id = "qwiklabs-gcp-00-000000000000"

# Votre IP publique (commande : curl -4 ifconfig.me), suivie de /32.
ssh_source_ranges = ["203.0.113.10/32"]

# Région et zone données par le lab : décommenter LES DEUX lignes ensemble.
# La zone doit être dans la région (ex. us-east4 → us-east4-b).
# Si elles restent commentées, Terraform utilise europe-west1 / europe-west1-b.
# region       = "us-east4"
# zone         = "us-east4-b"

# Optionnel :
# machine_type = "e2-small"
# vm_count     = 2
